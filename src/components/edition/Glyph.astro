---
// Ấn ký: the publication's own glyphs. Drawn on a 24-unit grid with one
// 1.6-unit stroke, square ends and mitred corners, so they read as rule-work
// cut by the same hand as the text beside them. At 20px the stroke is 1.33px,
// the stem of Mona Sans at label size; they never look thinner or heavier than
// the words they stand next to. `inline` sizes a glyph to the surrounding text.
const paths = {
  search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.2 15.2 20.5 20.5"/>',
  forward: '<path d="M3.5 12h16M13.5 6l6 6-6 6"/>',
  back: '<path d="M20.5 12h-16M10.5 6l-6 6 6 6"/>',
  up: '<path d="M12 20.5v-16M6 10.5l6-6 6 6"/>',
  down: '<path d="M12 3.5v16M6 13.5l6 6 6-6"/>',
  external: '<path d="M6 18 17.2 6.8M8.5 6.5h9v9"/>',
  previous: '<path d="M15 5l-7 7 7 7"/>',
  next: '<path d="M9 5l7 7-7 7"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  contents: '<path d="M9 6.5h11.5M9 12h11.5M9 17.5h7M3.5 6.5h1.8M3.5 12h1.8M3.5 17.5h1.8"/>',
  sun: '<circle cx="12" cy="12" r="3.8"/><path d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/>',
  moon: '<path d="M19.6 14.6A8 8 0 1 1 9.4 4.4a6.4 6.4 0 0 0 10.2 10.2Z"/>',
  auto: '<circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none"/>',
  mail: '<path d="M3.5 5.5h17v13h-17z"/><path d="M3.8 6.2 12 13l8.2-6.8"/>',
  link: '<path d="M10.4 13.6a3.6 3.6 0 0 0 5.1 0l3.3-3.3a3.6 3.6 0 0 0-5.1-5.1l-1.3 1.3"/><path d="M13.6 10.4a3.6 3.6 0 0 0-5.1 0l-3.3 3.3a3.6 3.6 0 0 0 5.1 5.1l1.3-1.3"/>',
  copy: '<path d="M8.5 8.5h11v11h-11z"/><path d="M15.5 8.5v-4h-11v11h4"/>',
  check: '<path d="M4.5 12.5l5 5L19.5 7"/>',
  download: '<path d="M12 3.5v11.5M6.5 9.5l5.5 5.5 5.5-5.5M4 20h16"/>',
  quotes:
    '<circle cx="7" cy="15.2" r="2.6" fill="currentColor" stroke="none"/><circle cx="16" cy="15.2" r="2.6" fill="currentColor" stroke="none"/><path d="M4.6 15C4.6 10.6 6.4 7.8 9.6 6.4M13.6 15c0-4.4 1.8-7.2 5-8.6"/>',
  rss: '<path d="M5 5.5A13.5 13.5 0 0 1 18.5 19M5 11a8 8 0 0 1 8 8"/><path d="M5 17.2h1.8V19H5z" fill="currentColor" stroke="none"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.3l3.5 2.1"/>',
  menu: '<path d="M3.5 7.5h17M3.5 12h17M3.5 16.5h17"/>',
  mark: '<path d="M4 12h16M12 4v16" stroke-width="1.2"/>',
  // The two marks of adding a page to a home screen, as the phone itself draws
  // them: the tray with its arrow (share), the square with its cross (add).
  share: '<path d="M8.5 9.5h-3v10.5h13V9.5h-3"/><path d="M12 14.5V3.5M8.5 7 12 3.5 15.5 7"/>',
  install: '<path d="M4.5 4.5h15v15h-15z"/><path d="M12 8.5v7M8.5 12h7"/>',
} as const;

export type GlyphName = keyof typeof paths;
interface Props {
  name: GlyphName;
  size?: number;
  inline?: boolean;
  class?: string;
}
const { name, size = 20, inline = false, class: className } = Astro.props;
const dimension = inline ? '1.2em' : String(size);
---
<svg
  class:list={['glyph', inline && 'glyph--inline', className]}
  data-glyph={name}
  viewBox="0 0 24 24"
  width={dimension}
  height={dimension}
  aria-hidden="true"
  set:html={paths[name]}
/>
